# Server config
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://localhost:27017/tessera
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/tessera?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/tessera

# JWT secret — use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret-string
