{
  "name": "team-task-manager",
  "version": "1.0.0",
  "description": "Full-stack team task manager with role-based access control",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.7"
  }
}
